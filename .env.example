# ─── Auth (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ─── Banco (Cloudflare D1) ─────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ─── Storage (Cloudflare R2) ───────────────────────────────────────────────
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── Geração (fal.ai / RunPod) ─────────────────────────────────────────────
FAL_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_FLUX_SCHNELL=
RUNPOD_ENDPOINT_FLUX_DEV=
RUNPOD_ENDPOINT_WAN=
RUNPOD_ENDPOINT_HUNYUAN=

# ─── Pagamento (Stripe) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_API_CREDITS_STARTER=
STRIPE_PRICE_API_CREDITS_GROWTH=
STRIPE_PRICE_API_CREDITS_PRO=
STRIPE_PRICE_API_CREDITS_SCALE=

# ─── E-mail e CRM (Resend) ─────────────────────────────────────────────────
# RESEND_API_KEY é a mesma chave usada pelos scripts enviar_nova.*
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Segredo do webhook de eventos (Resend > Webhooks). Sem ele, bounce e
# reclamação não entram na supressão automaticamente.
RESEND_WEBHOOK_SECRET=
CRM_FROM_EMAIL="NOVA AI Studio <noreply@novvideos.online>"
CRM_REPLY_TO=novavideoai@proton.me
CRM_DEFAULT_LOCALE=en

# Protege /api/cron/crm-dispatch. Sem isto o cron recusa TODAS as chamadas.
# Gere com: openssl rand -base64 32
CRON_SECRET=

# ─── Admin ─────────────────────────────────────────────────────────────────
ADMIN_SECRET=
NOVA_ADMIN_EMAILS=
NOVA_ADMIN_USER_IDS=
OWNER_EMAIL=

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.novvideos.online
NEXT_PUBLIC_BASE_URL=https://www.novvideos.online
